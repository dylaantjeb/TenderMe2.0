generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String?          @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           UserRole         @default(EDITOR)
  tier           SubscriptionTier @default(FREE)
  organizationId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  accounts      Account[]
  sessions      Session[]
  organization  Organization?    @relation(fields: [organizationId], references: [id])
  tenders       Tender[]
  responses     TenderResponse[]
  auditLogs     AuditLog[]
  aiUsageLogs   AIUsageLog[]

  @@index([organizationId])
  @@index([email])
}

model Organization {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  tier             SubscriptionTier @default(FREE)
  stripeCustomerId String?          @unique
  subscriptionId   String?
  subscriptionEnd  DateTime?
  maxUsers         Int              @default(5)
  maxTendersMonth  Int              @default(10)
  settings         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users    User[]
  tenders  Tender[]
  apiKeys  ApiKey[]
}

model ApiKey {
  id             String       @id @default(cuid())
  key            String       @unique
  name           String
  organizationId String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ============================================
// TENDERS & DOCUMENTS
// ============================================

enum TenderStatus {
  DRAFT
  IMPORTING
  ANALYZING
  CRITERIA_EXTRACTED
  GENERATING
  REVIEW
  SCORING
  FINAL
  SUBMITTED
  ARCHIVED
}

enum TenderSource {
  UPLOAD
  TENDERNED
  MERCELL
  MANUAL
}

model Tender {
  id               String       @id @default(cuid())
  title            String
  referenceNumber  String?
  description      String?      @db.Text
  status           TenderStatus @default(DRAFT)
  source           TenderSource @default(UPLOAD)
  sourceUrl        String?
  deadline         DateTime?
  budget           Decimal?     @db.Decimal(12, 2)
  currency         String       @default("EUR")
  contractingAuth  String?
  sector           String?
  region           String?
  language         String       @default("nl")
  overallScore     Float?
  metadata         Json?
  userId           String
  organizationId   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  organization  Organization?  @relation(fields: [organizationId], references: [id])
  documents     Document[]
  criteria      Criterion[]
  responses     TenderResponse[]
  context       TenderContext?
  versions      TenderVersion[]
  auditLogs     AuditLog[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model Document {
  id           String   @id @default(cuid())
  tenderId     String
  fileName     String
  fileType     String
  fileSize     Int
  storagePath  String
  extractedText String?  @db.Text
  ocrApplied   Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
}

// ============================================
// CRITERIA & SCORING
// ============================================

enum CriterionType {
  QUALITY
  PRICE
  KNOCKOUT
  SOCIAL
  SUSTAINABILITY
  TECHNICAL
  OTHER
}

model Criterion {
  id              String        @id @default(cuid())
  tenderId        String
  name            String
  description     String?       @db.Text
  type            CriterionType @default(QUALITY)
  weight          Float         @default(0)
  maxScore        Float         @default(10)
  isKnockout      Boolean       @default(false)
  knockoutReq     String?       @db.Text
  scoringMethod   String?
  evaluatorNotes  String?       @db.Text
  parentId        String?
  sortOrder       Int           @default(0)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tender    Tender            @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  parent    Criterion?        @relation("SubCriteria", fields: [parentId], references: [id])
  children  Criterion[]       @relation("SubCriteria")
  responses CriterionResponse[]

  @@index([tenderId])
  @@index([parentId])
}

// ============================================
// RESPONSES & GENERATION
// ============================================

enum ResponseStatus {
  PENDING
  GENERATING
  DRAFT
  SCORING
  ITERATING
  REVIEWED
  APPROVED
  LOCKED
}

model TenderResponse {
  id             String         @id @default(cuid())
  tenderId       String
  userId         String
  status         ResponseStatus @default(PENDING)
  overallScore   Float?
  iterationCount Int            @default(0)
  maxIterations  Int            @default(2)
  aiModel        String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tender            Tender              @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id])
  criterionResponses CriterionResponse[]

  @@index([tenderId])
  @@index([userId])
}

model CriterionResponse {
  id                String         @id @default(cuid())
  tenderResponseId  String
  criterionId       String
  content           String         @db.Text
  understanding     String?        @db.Text
  solution          String?        @db.Text
  evidence          String?        @db.Text
  riskMitigation    String?        @db.Text
  measurableImpact  String?        @db.Text
  score             Float?
  scoreJustification String?       @db.Text
  weaknesses        String?        @db.Text
  complianceNotes   String?        @db.Text
  iterationNumber   Int            @default(0)
  status            ResponseStatus @default(PENDING)
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenderResponse TenderResponse @relation(fields: [tenderResponseId], references: [id], onDelete: Cascade)
  criterion      Criterion      @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([tenderResponseId])
  @@index([criterionId])
}

// ============================================
// TENDER CONTEXT (AI Layer 1 Output)
// ============================================

model TenderContext {
  id                  String   @id @default(cuid())
  tenderId            String   @unique
  scope               String?  @db.Text
  objectives          String?  @db.Text
  constraints         String?  @db.Text
  risks               String?  @db.Text
  politicalSensitivity String? @db.Text
  timeline            String?  @db.Text
  stakeholders        String?  @db.Text
  scoringModel        String?  @db.Text
  evaluatorPriorities String?  @db.Text
  scoreMultipliers    Json?
  rawAnalysis         Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
}

// ============================================
// VERSION CONTROL
// ============================================

model TenderVersion {
  id        String   @id @default(cuid())
  tenderId  String
  version   Int
  snapshot  Json
  changeLog String?  @db.Text
  createdBy String
  createdAt DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([tenderId, version])
  @@index([tenderId])
}

// ============================================
// AUDIT & TRACKING
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  tenderId   String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  tender Tender? @relation(fields: [tenderId], references: [id])

  @@index([userId])
  @@index([tenderId])
  @@index([createdAt])
  @@index([action])
}

model AIUsageLog {
  id          String   @id @default(cuid())
  userId      String
  model       String
  provider    String
  operation   String
  inputTokens Int
  outputTokens Int
  cost        Decimal  @db.Decimal(10, 6)
  latencyMs   Int
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
